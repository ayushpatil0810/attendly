<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_medium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Left Column: Circular Donut Gauge & Status Badge (Digital Wellbeing Style) -->
    <LinearLayout
        android:layout_width="100dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp">

            <ProgressBar
                android:id="@+id/widget_medium_progress_ring"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_circular_progress" />

            <TextView
                android:id="@+id/widget_medium_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:text="—"
                android:textColor="@color/widget_ink"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_medium_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_badge_meeting"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="On Track"
            android:textColor="@color/widget_ink_mint"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- Subtle Vertical Divider -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:background="@color/widget_border" />

    <!-- Right Column: Semester Title, Action & Top 3 Subject Bars -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Top Header: Semester Name & Quick Log Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_medium_semester_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Current Semester"
                android:textColor="@color/widget_ink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Compact Quick Log Shortcut -->
            <LinearLayout
                android:id="@+id/widget_medium_btn_quick_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_btn_quick_log"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginEnd="3dp"
                    android:contentDescription="Quick Log Icon"
                    android:src="@drawable/ic_widget_add" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Log"
                    android:textColor="@color/widget_pure_white"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Empty Subjects Indicator -->
        <TextView
            android:id="@+id/widget_medium_empty_subjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif"
            android:text="Add courses in Attendly to track"
            android:textColor="@color/widget_muted_ink"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Subject 1 Row -->
        <LinearLayout
            android:id="@+id/widget_m_s1_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_m_s1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Subject 1"
                android:textColor="@color/widget_ink"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/widget_m_s1_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="54dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="75"
                android:progressDrawable="@drawable/widget_progress_horizontal" />

            <TextView
                android:id="@+id/widget_m_s1_pct"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="end"
                android:text="75%"
                android:textColor="@color/widget_ink"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Subject 2 Row -->
        <LinearLayout
            android:id="@+id/widget_m_s2_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_m_s2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Subject 2"
                android:textColor="@color/widget_ink"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/widget_m_s2_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="54dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="80"
                android:progressDrawable="@drawable/widget_progress_horizontal_violet" />

            <TextView
                android:id="@+id/widget_m_s2_pct"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="end"
                android:text="80%"
                android:textColor="@color/widget_ink"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Subject 3 Row -->
        <LinearLayout
            android:id="@+id/widget_m_s3_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_m_s3_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Subject 3"
                android:textColor="@color/widget_ink"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/widget_m_s3_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="54dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="65"
                android:progressDrawable="@drawable/widget_progress_horizontal" />

            <TextView
                android:id="@+id/widget_m_s3_pct"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="end"
                android:text="65%"
                android:textColor="@color/widget_ink"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>