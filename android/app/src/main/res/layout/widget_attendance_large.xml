<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_large_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Bar: Semester Name & Quick Log Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_large_semester_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Current Semester"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Quick Log Shortcut Button -->
        <LinearLayout
            android:id="@+id/widget_large_btn_quick_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_quick_log"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="Quick Log Icon"
                android:src="@drawable/ic_widget_add" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Log"
                android:textColor="@color/widget_pure_white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Overview Banner: Donut Progress Ring + Status & Advice (Digital Wellbeing Style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Circular Donut Ring -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">

            <ProgressBar
                android:id="@+id/widget_large_progress_ring"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_circular_progress" />

            <TextView
                android:id="@+id/widget_large_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:text="—"
                android:textColor="@color/widget_ink"
                android:textSize="17sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Right Side: Status Badge, Goal Badge & Advice -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_large_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_badge_meeting"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="On Track"
                    android:textColor="@color/widget_ink_mint"
                    android:textSize="10.5sp" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/widget_large_goal_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_badge_neutral"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="Req: 75%"
                    android:textColor="@color/widget_ink_violet"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_large_goal_advice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="Minimum threshold: 75%"
                android:textColor="@color/widget_muted_ink"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/widget_border" />

    <!-- Subject Breakdown Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="COURSES"
        android:textAllCaps="true"
        android:textColor="@color/widget_subtle_ink"
        android:textSize="10sp" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/widget_large_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="Log classes in Attendly to see subjects"
        android:textColor="@color/widget_muted_ink"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Subject Row 1 -->
    <LinearLayout
        android:id="@+id/widget_s1_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_s1_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Subject 1"
            android:textColor="@color/widget_ink"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/widget_s1_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="60dp"
            android:layout_height="6dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="75"
            android:progressDrawable="@drawable/widget_progress_horizontal" />

        <TextView
            android:id="@+id/widget_s1_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFamily="sans-serif"
            android:text="0/0"
            android:textColor="@color/widget_muted_ink"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/widget_s1_pct"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="end"
            android:text="—"
            android:textColor="@color/widget_ink"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subject Row 2 -->
    <LinearLayout
        android:id="@+id/widget_s2_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_s2_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Subject 2"
            android:textColor="@color/widget_ink"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/widget_s2_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="60dp"
            android:layout_height="6dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="80"
            android:progressDrawable="@drawable/widget_progress_horizontal_violet" />

        <TextView
            android:id="@+id/widget_s2_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFamily="sans-serif"
            android:text="0/0"
            android:textColor="@color/widget_muted_ink"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/widget_s2_pct"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="end"
            android:text="—"
            android:textColor="@color/widget_ink"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subject Row 3 -->
    <LinearLayout
        android:id="@+id/widget_s3_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_s3_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Subject 3"
            android:textColor="@color/widget_ink"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/widget_s3_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="60dp"
            android:layout_height="6dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="65"
            android:progressDrawable="@drawable/widget_progress_horizontal" />

        <TextView
            android:id="@+id/widget_s3_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFamily="sans-serif"
            android:text="0/0"
            android:textColor="@color/widget_muted_ink"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/widget_s3_pct"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="end"
            android:text="—"
            android:textColor="@color/widget_ink"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subject Row 4 -->
    <LinearLayout
        android:id="@+id/widget_s4_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_s4_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Subject 4"
            android:textColor="@color/widget_ink"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/widget_s4_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="60dp"
            android:layout_height="6dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="85"
            android:progressDrawable="@drawable/widget_progress_horizontal_violet" />

        <TextView
            android:id="@+id/widget_s4_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFamily="sans-serif"
            android:text="0/0"
            android:textColor="@color/widget_muted_ink"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/widget_s4_pct"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="end"
            android:text="—"
            android:textColor="@color/widget_ink"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>